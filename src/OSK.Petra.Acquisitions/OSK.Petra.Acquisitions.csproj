<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>14</LangVersion>
		<Nullable>enable</Nullable>

		<RepositoryUrl>https://github.com/OpenSourceKingdom/OSK.Petra.Acquisitions</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>CS1591</NoWarn>
		<Authors>BlankDev117</Authors>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>Provides a system that handles acquiring things in an application or game - that is, handling data such as tech upgrades, tech trees, unit purchasing, queue/build system, and more.</Description>
		<PackageTags>OpenSourceKingdom, OpenSource, Acquire Acquisition, Queue, Tech, Upgrade, Tree, Purchase, Provision, Skill</PackageTags>
		<Title>OSK.Petra.Acquisitions</Title>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageReference Include="OSK.Hexagonal.MetaData" Version="1.0.0" />
		<PackageReference Include="OSK.Extensions.Petra.Calculators.Provisions" Version="0.2.0" />
		<PackageReference Include="OSK.Petra.Provisions" Version="0.3.0" />
		<PackageReference Include="PolySharp" Version="1.16.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
